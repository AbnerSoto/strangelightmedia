---
import { withBase } from "../lib/url";
import LogoMark from "../assets/logo-mark.svg";

const links = [
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---

<header class="site-nav">
  <div class="container site-nav__inner">
    <a href={withBase("/")} class="site-nav__logo" aria-label="Strange Light Media, home">
      <LogoMark class="site-nav__logo-mark" aria-hidden="true" />
      <span class="site-nav__logo-text">Strangelight</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={withBase(link.href)}
                aria-current={
                  currentPath.startsWith(withBase(link.href))
                    ? "page"
                    : undefined
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .site-nav__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
  }

  .site-nav__logo-mark {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
  }

  .site-nav__logo-text {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  /* Below ~420px the wordmark crowds the nav links; show the mark alone. */
  @media (max-width: 419px) {
    .site-nav__logo-text {
      display: none;
    }
  }

  nav ul {
    display: flex;
    gap: var(--space-3);
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-accent);
  }
</style>
