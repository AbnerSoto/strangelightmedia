---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { withBase } from "../lib/url";

import workPortrait1 from "../assets/homepage/work-portrait-1.webp";
import workPortrait2 from "../assets/homepage/work-portrait-2.webp";
import workArchitecture1 from "../assets/homepage/work-architecture-1.webp";
import workArchitecture2 from "../assets/homepage/work-architecture-2.webp";
import workProduct1 from "../assets/homepage/work-product-1.webp";
import workProduct2 from "../assets/homepage/work-product-2.webp";

// Temporary: sourced from the live abnersoto.com site as placeholder
// imagery for this homepage redesign, until Strange Light Media has its
// own shoot to pull from — swap these for real work whenever it exists.
const workSamples = [
  { src: workArchitecture1, alt: "Primary bedroom interior, warm evening light", category: "architecture" },
  { src: workPortrait1, alt: "Studio portrait, subject smiling with arms crossed", category: "portraits" },
  { src: workProduct1, alt: "Product still life", category: "product" },
  { src: workProduct2, alt: "Product still life", category: "product" },
  { src: workPortrait2, alt: "Studio portrait", category: "portraits" },
  { src: workArchitecture2, alt: "Architectural interior", category: "architecture" },
];

const audiences = [
  { name: "Real estate agents", body: "Listings that stop the scroll, and a personal brand that wins the next listing." },
  { name: "Builders & developers", body: "Launch films and campaigns that sell the project before it's finished." },
  { name: "Local businesses", body: "Content with real character, made in Sacramento." },
];

const services = [
  { num: "01", name: "Film & video", body: "Brand films, listing tours and short cuts for social." },
  { num: "02", name: "Photography", body: "Property, people and product, shot with real light." },
  { num: "03", name: "Social content", body: "Reels, carousels and monthly content that looks like you." },
  { num: "04", name: "Campaigns & brand", body: "Strategy, ads and launches built around the visuals." },
];

const steps = [
  { name: "Find the light", body: "A quick call to find the real story and the angle no one else is shooting." },
  { name: "Shoot it like a film", body: "On location or in studio, composed and lit with intention — not a flat listing shot." },
  { name: "Launch, then keep going", body: "Delivered fast, ready for the feed, the site, the sign." },
];

const traits = ["Cinematic", "Unexpected", "Sharp", "Rooted"];
---

<BaseLayout
  title="Strange Light Media"
  description="We make Sacramento brands impossible to scroll past."
>
  <section class="hero-banner">
    <canvas
      class="hero-banner__canvas"
      id="hero-kinetic-bg"
      aria-hidden="true"
    ></canvas>
    <div class="hero container">
      <p class="hero__eyebrow">Sacramento · Marketing &amp; production</p>
      <h1>Strange<br />Light<span class="hero__sub">Media</span></h1>
      <p class="hero__tagline">
        Marketing that looks like nothing else in the valley.
      </p>
      <div class="hero__ctas">
        <a href={withBase("/work")} class="hero__cta">View the work &rarr;</a>
        <a href={withBase("/contact")} class="hero__cta hero__cta--secondary">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="container positioning">
    <h2 class="positioning__statement">
      We make Sacramento brands <span class="accent">impossible to scroll past.</span>
    </h2>
    <ul class="positioning__audiences">
      {
        audiences.map((a) => (
          <li>
            <h3>{a.name}</h3>
            <p>{a.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container services">
    <p class="section-eyebrow">What we do</p>
    <ul class="services__grid">
      {
        services.map((s) => (
          <li class="services__card">
            <p class="services__num">{s.num}</p>
            <h3>{s.name}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container work">
    <div class="work__header">
      <p class="section-eyebrow">Recent work</p>
      <a href={withBase("/work")} class="work__all">See all work &rarr;</a>
    </div>
    <ul class="work__grid">
      {
        workSamples.map((w) => (
          <li>
            <a href={withBase(`/work/${w.category}`)}>
              <Image src={w.src} alt={w.alt} width={700} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container process">
    <p class="section-eyebrow">How it works</p>
    <ol class="process__steps">
      {
        steps.map((step, i) => (
          <li>
            <p class="process__num">{String(i + 1).padStart(2, "0")}</p>
            <h3>{step.name}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container traits">
    <ul class="traits__list">
      {traits.map((trait) => <li>{trait}</li>)}
    </ul>
  </section>

  <section class="container cta">
    <h2>Make it seen.</h2>
    <p>Tell us about the project and we'll follow up to talk dates and details.</p>
    <a href={withBase("/contact")} class="hero__cta">Get in touch &rarr;</a>
  </section>
</BaseLayout>

<style>
  .hero-banner {
    position: relative;
    overflow: hidden;
  }

  .hero-banner__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  .hero {
    position: relative;
    padding-block: var(--space-6);
    max-width: 700px;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .hero h1 {
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    letter-spacing: -0.02em;
    line-height: 0.95;
  }

  /* "Media", set apart from the stacked "Strange Light" wordmark above
     it — matches the brand deck's cover slide treatment (a
     wide-tracked mono subline in the accent color). */
  .hero__sub {
    display: block;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.35em;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 0.5em;
  }

  .hero__tagline {
    margin-top: var(--space-3);
    max-width: 30ch;
    color: var(--color-text-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .hero__cta {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    color: var(--color-accent);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .hero__cta--secondary {
    color: var(--color-text-muted);
  }

  .accent {
    color: var(--color-accent);
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  /* Positioning / audience */
  .positioning {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .positioning__statement {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    line-height: 1.15;
    max-width: 18ch;
    margin-bottom: var(--space-5);
  }

  .positioning__audiences {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 760px) {
    .positioning__audiences {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .positioning__audiences h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .positioning__audiences p {
    color: var(--color-text-muted);
  }

  /* Services */
  .services {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .services__grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .services__card {
    border-top: 2px solid var(--color-border);
    padding-top: var(--space-2);
  }

  .services__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .services__card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .services__card p:not(.services__num) {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  /* Work */
  .work {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .work__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .work__header .section-eyebrow {
    margin-bottom: 0;
  }

  .work__all {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  @media (min-width: 760px) {
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .work__grid :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 0.2s ease;
  }

  .work__grid a:hover :global(img) {
    opacity: 0.85;
  }

  /* Process */
  .process {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .process__steps {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 760px) {
    .process__steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .process__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .process__steps h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .process__steps p:not(.process__num) {
    color: var(--color-text-muted);
  }

  /* Traits band */
  .traits {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .traits__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .traits__list li {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .traits__list li::before {
    content: "";
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    border-radius: 50%;
    background: var(--color-accent);
    margin-right: 0.5em;
    vertical-align: middle;
  }

  /* Closing CTA */
  .cta {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .cta h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-2);
  }

  .cta p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .cta .hero__cta {
    display: inline-block;
  }
</style>

<script>
  interface Circle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
    lineWidth: number;
    opacity: number;
    // 0 draws a plain circle outline; 3+ draws a regular polygon (that
    // many sides) inscribed in the same radius instead, for a more
    // angular, faceted look mixed in among the circles.
    sides: number;
    rotation: number;
    rotationSpeed: number;
    // Each shape alternates between an idle phase (holding `sides`) and a
    // morph phase (smoothly reshaping from `fromSides` to `toSides`).
    // idleFrames/MORPH_FRAMES are sized so only ~20% of shapes are
    // mid-morph at any moment, and morphTimer starts pre-randomized so
    // shapes don't all start their cycles in lockstep.
    morphing: boolean;
    fromSides: number;
    toSides: number;
    morphTimer: number;
    idleFrames: number;
    // Eased 0-1 toward 1 while the cursor is over this shape, toward 0
    // otherwise — drives a brightened, bolder highlight in draw().
    hoverAmount: number;
    // Most shapes bounce off the edges forever (existing behavior). A
    // minority instead pass straight through and get removed once fully
    // offscreen — see the population-management block in step().
    bounces: boolean;
  }

  // With view transitions, this script's module only ever loads once per
  // browser session — astro:page-load (not DOMContentLoaded) is what
  // re-runs initHeroKineticBackground on every subsequent navigation back
  // to this page, and astro:before-swap runs this cleanup beforehand so
  // the previous instance's rAF loop and global listeners don't keep
  // running in the background against a now-removed canvas.
  let cleanupKinetic: (() => void) | null = null;

  function initHeroKineticBackground() {
    cleanupKinetic?.();
    cleanupKinetic = null;

    const canvasRaw = document.getElementById("hero-kinetic-bg");
    if (!(canvasRaw instanceof HTMLCanvasElement)) return;
    const canvas: HTMLCanvasElement = canvasRaw;
    const banner = canvas.closest<HTMLElement>(".hero-banner");
    const ctx = canvas.getContext("2d");
    if (!banner || !ctx) return;

    const LINE_DISTANCE = 170;
    // Film White ambient shapes/lines against the Darkroom background —
    // the brand deck's accent (Flare) is reserved for the hover
    // highlight below, "used once per frame, like a light leak."
    const SHAPE_COLOR: [number, number, number] = [242, 237, 228];
    const LINE_COLOR = "242, 237, 228";
    const HOVER_COLOR: [number, number, number] = [255, 90, 54];

    function lerpColor(
      a: [number, number, number],
      b: [number, number, number],
      t: number,
    ): string {
      return `${a[0] + (b[0] - a[0]) * t}, ${a[1] + (b[1] - a[1]) * t}, ${a[2] + (b[2] - a[2]) * t}`;
    }

    // Assuming ~60fps: a 2s morph with an average 8s idle gap between
    // morphs works out to ~120 / (120 + 480) = 20% of shapes mid-morph
    // at any moment, on average, once many shapes are running staggered,
    // independently-timed cycles.
    const MORPH_FRAMES = 120;
    const IDLE_FRAMES_MIN = 360;
    const IDLE_FRAMES_MAX = 600;
    const SHAPE_OPTIONS = [0, 3, 4, 5, 6]; // 0 = circle, 3-6 = polygon sides

    function randomIdleFrames() {
      return (
        IDLE_FRAMES_MIN + Math.random() * (IDLE_FRAMES_MAX - IDLE_FRAMES_MIN)
      );
    }

    function randomOtherShape(current: number) {
      const options = SHAPE_OPTIONS.filter((s) => s !== current);
      return options[Math.floor(Math.random() * options.length)];
    }

    function easeInOutCubic(t: number) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    // Distance from center to a regular polygon's boundary at a given
    // angle (relative to the shape's own rotation) — constant (the
    // circle's radius) when sides is 0. Sampling this at many angles is
    // what lets a shape morph smoothly between different side counts (or
    // to/from a circle): interpolate the radius per-angle, not the shape
    // outright.
    function shapeRadiusAt(theta: number, sides: number, r: number) {
      if (sides < 3) return r;
      const segment = (Math.PI * 2) / sides;
      const local = ((theta % segment) + segment) % segment - segment / 2;
      return (r * Math.cos(Math.PI / sides)) / Math.cos(local);
    }

    let width = 0;
    let height = 0;
    let circles: Circle[] = [];
    let mouseX: number | null = null;
    let mouseY: number | null = null;

    // Ghost trail: recent positions/forms of whichever shape is currently
    // hovered, oldest first, rendered faintest to most recent. Decays by
    // dropping its oldest entry each frame once nothing is hovered, so it
    // shortens away rather than vanishing abruptly.
    interface TrailPoint {
      x: number;
      y: number;
      r: number;
      sides: number;
      rotation: number;
    }
    const TRAIL_MAX_LENGTH = 16;
    let trail: TrailPoint[] = [];
    let trailOwner: Circle | null = null;

    // Population management for the non-bouncing shapes that pass through
    // the edge and get removed (see step()): targetCount is the steady
    // -state total, and respawnFrames tracks a delay before each removed
    // shape is replaced so the total can dip below target for a bit
    // rather than snapping back instantly — capped at
    // MAX_POPULATION_DIP so the count never strays more than that from
    // targetCount.
    let targetCount = 0;
    let respawnFrames: number[] = [];
    const MAX_POPULATION_DIP = 3;

    function spawnCircle(): Circle {
      // Roughly a third of shapes start as angular polygons (3-6 sides),
      // the rest as circles — each will go on to morph between shapes on
      // its own staggered cycle regardless of where it starts.
      const sides = Math.random() < 0.35 ? 3 + Math.floor(Math.random() * 4) : 0;
      const idleFrames = randomIdleFrames();
      return {
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.45,
        vy: (Math.random() - 0.5) * 0.45,
        r: 18 + Math.random() * 46,
        // Varying these per circle (hairline/faint vs. bold/solid) is
        // what reads as a technical schematic rather than uniform,
        // cartoonish bubbles — mimics different "layers" of emphasis on
        // a diagram.
        lineWidth: 0.5 + Math.random() * 2,
        opacity: 0.05 + Math.random() * 0.12, // max stays below the 0.175 flat value set earlier
        sides,
        rotation: Math.random() * Math.PI * 2,
        rotationSpeed: (Math.random() - 0.5) * 0.01,
        morphing: false,
        fromSides: sides,
        toSides: sides,
        // Pre-randomized within the idle window so shapes don't all
        // start their morph cycles in sync.
        morphTimer: Math.random() * idleFrames,
        idleFrames,
        hoverAmount: 0,
        // Most shapes bounce; a minority pass through the edge instead.
        bounces: Math.random() < 0.65,
      };
    }

    function seedCircles() {
      targetCount = Math.max(6, Math.round((width * height) / 65000));
      circles = Array.from({ length: targetCount }, spawnCircle);
      respawnFrames = [];
    }

    function resize() {
      const rect = banner!.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      seedCircles();
    }

    // Equal-mass elastic collision: swap the velocity component along the
    // line connecting the two centers, leave the perpendicular component
    // untouched — this is what makes the lines between circles feel
    // "kinetic" rather than just decorative, since their length and
    // opacity keep shifting as circles actually bounce off each other.
    function resolveCollision(a: Circle, b: Circle) {
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dist = Math.hypot(dx, dy) || 0.0001;
      const minDist = a.r + b.r;
      if (dist >= minDist) return;

      const nx = dx / dist;
      const ny = dy / dist;
      const overlap = (minDist - dist) / 2;
      a.x -= nx * overlap;
      a.y -= ny * overlap;
      b.x += nx * overlap;
      b.y += ny * overlap;

      const aN = a.vx * nx + a.vy * ny;
      const bN = b.vx * nx + b.vy * ny;
      a.vx += (bN - aN) * nx;
      a.vy += (bN - aN) * ny;
      b.vx += (aN - bN) * nx;
      b.vy += (aN - bN) * ny;
    }

    function step() {
      let currentHoveredCircle: Circle | null = null;
      for (const c of circles) {
        c.x += c.vx;
        c.y += c.vy;
        c.rotation += c.rotationSpeed;

        const hovered =
          mouseX !== null &&
          mouseY !== null &&
          Math.hypot(c.x - mouseX, c.y - mouseY) < c.r;
        if (hovered) currentHoveredCircle = c;
        c.hoverAmount += ((hovered ? 1 : 0) - c.hoverAmount) * 0.15;

        c.morphTimer++;
        if (!c.morphing) {
          if (c.morphTimer >= c.idleFrames) {
            c.morphing = true;
            c.morphTimer = 0;
            c.fromSides = c.sides;
            c.toSides = randomOtherShape(c.sides);
          }
        } else if (c.morphTimer >= MORPH_FRAMES) {
          c.morphing = false;
          c.morphTimer = 0;
          c.sides = c.toSides;
          c.idleFrames = randomIdleFrames();
        }

        if (c.bounces) {
          if (c.x - c.r < 0) {
            c.x = c.r;
            c.vx = Math.abs(c.vx);
          } else if (c.x + c.r > width) {
            c.x = width - c.r;
            c.vx = -Math.abs(c.vx);
          }
          if (c.y - c.r < 0) {
            c.y = c.r;
            c.vy = Math.abs(c.vy);
          } else if (c.y + c.r > height) {
            c.y = height - c.r;
            c.vy = -Math.abs(c.vy);
          }
        }
      }
      for (let i = 0; i < circles.length; i++) {
        for (let j = i + 1; j < circles.length; j++) {
          resolveCollision(circles[i], circles[j]);
        }
      }

      // Non-bouncing shapes that have fully left the visible area
      // disappear instead of reflecting. Each is eventually replaced —
      // immediately if the population has already dipped by
      // MAX_POPULATION_DIP, otherwise after a random delay — so the
      // total count stays within that many of targetCount rather than
      // snapping straight back.
      const survivors: Circle[] = [];
      let removed = 0;
      for (const c of circles) {
        const offscreen =
          !c.bounces &&
          (c.x + c.r < 0 ||
            c.x - c.r > width ||
            c.y + c.r < 0 ||
            c.y - c.r > height);
        if (offscreen) {
          removed++;
        } else {
          survivors.push(c);
        }
      }
      circles = survivors;
      for (let i = 0; i < removed; i++) {
        // Deliberately ignores respawnFrames.length: a queued-but-not-yet-
        // spawned replacement doesn't help anyone looking at the screen
        // right now, so only the actually-visible count should gate the
        // dip cap, not the count "on paper."
        const visibleDeficit = targetCount - circles.length;
        if (visibleDeficit >= MAX_POPULATION_DIP) {
          circles.push(spawnCircle());
        } else {
          respawnFrames.push(30 + Math.random() * 120); // 0.5-2.5s @ 60fps
        }
      }
      for (let i = respawnFrames.length - 1; i >= 0; i--) {
        respawnFrames[i]--;
        if (respawnFrames[i] <= 0) {
          circles.push(spawnCircle());
          respawnFrames.splice(i, 1);
        }
      }

      if (currentHoveredCircle) {
        if (trailOwner !== currentHoveredCircle) {
          trail = [];
          trailOwner = currentHoveredCircle;
        }
        trail.push({
          x: currentHoveredCircle.x,
          y: currentHoveredCircle.y,
          r: currentHoveredCircle.r,
          sides: currentHoveredCircle.sides,
          rotation: currentHoveredCircle.rotation,
        });
        if (trail.length > TRAIL_MAX_LENGTH) trail.shift();
      } else if (trail.length > 0) {
        trail.shift();
        if (trail.length === 0) trailOwner = null;
      }
    }

    function draw() {
      ctx!.clearRect(0, 0, width, height);

      for (let i = 0; i < circles.length; i++) {
        for (let j = i + 1; j < circles.length; j++) {
          const a = circles[i];
          const b = circles[j];
          const dist = Math.hypot(b.x - a.x, b.y - a.y);
          if (dist >= LINE_DISTANCE) continue;
          const alpha = 0.198 * (1 - dist / LINE_DISTANCE);
          ctx!.strokeStyle = `rgba(${LINE_COLOR}, ${alpha})`;
          ctx!.lineWidth = 1;
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          ctx!.lineTo(b.x, b.y);
          ctx!.stroke();
        }
      }

      // Ghost trail for the hovered shape: oldest entries faintest, drawn
      // before the live shapes so the real, brightest copy ends up on top.
      // Flare orange, same as the hover highlight below — this trail only
      // ever exists behind the one shape currently being lit up.
      const TRAIL_MAX_ALPHA = 0.14;
      trail.forEach((p, i) => {
        const alpha = TRAIL_MAX_ALPHA * ((i + 1) / trail.length);
        ctx!.strokeStyle = `rgba(${HOVER_COLOR.join(", ")}, ${alpha})`;
        ctx!.lineWidth = 1;
        ctx!.beginPath();
        if (p.sides < 3) {
          ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        } else {
          for (let s = 0; s < p.sides; s++) {
            const angle = p.rotation + (s / p.sides) * Math.PI * 2;
            const px = p.x + Math.cos(angle) * p.r;
            const py = p.y + Math.sin(angle) * p.r;
            s === 0 ? ctx!.moveTo(px, py) : ctx!.lineTo(px, py);
          }
          ctx!.closePath();
        }
        ctx!.stroke();
      });

      const SHAPE_SEGMENTS = 48;
      for (const c of circles) {
        // Brighten and thicken toward a hovered look as hoverAmount eases
        // toward 1, rather than snapping instantly — capped well below
        // full opacity so it reads as a highlight, not a different shape.
        const drawOpacity = c.opacity + (0.45 - c.opacity) * c.hoverAmount;
        const drawLineWidth = c.lineWidth + c.hoverAmount * 1.5;
        // Shifts from the neutral Film White toward Flare orange as
        // hoverAmount eases in — "the accent used once per frame, like a
        // light leak" applied to whichever single shape is lit up.
        const drawColor = lerpColor(SHAPE_COLOR, HOVER_COLOR, c.hoverAmount);
        ctx!.strokeStyle = `rgba(${drawColor}, ${drawOpacity})`;
        ctx!.lineWidth = drawLineWidth;
        ctx!.beginPath();

        if (c.morphing) {
          // Sampling shapeRadiusAt at fixed angles is the simplest way to
          // blend two different polygons' radii, but it makes a sharp
          // vertex wiggle slightly as rotation shifts which sample lands
          // nearest it — acceptable for a 2s transition, but drawing the
          // idle (non-morphing) shape from its exact vertices below keeps
          // corners genuinely crisp and static the other ~80% of the time.
          const morphT = easeInOutCubic(c.morphTimer / MORPH_FRAMES);
          for (let i = 0; i <= SHAPE_SEGMENTS; i++) {
            const theta = (i / SHAPE_SEGMENTS) * Math.PI * 2;
            const localTheta = theta - c.rotation;
            const r =
              shapeRadiusAt(localTheta, c.fromSides, c.r) +
              (shapeRadiusAt(localTheta, c.toSides, c.r) -
                shapeRadiusAt(localTheta, c.fromSides, c.r)) *
                morphT;
            const px = c.x + Math.cos(theta) * r;
            const py = c.y + Math.sin(theta) * r;
            i === 0 ? ctx!.moveTo(px, py) : ctx!.lineTo(px, py);
          }
        } else if (c.sides < 3) {
          ctx!.arc(c.x, c.y, c.r, 0, Math.PI * 2);
        } else {
          for (let i = 0; i < c.sides; i++) {
            const angle = c.rotation + (i / c.sides) * Math.PI * 2;
            const px = c.x + Math.cos(angle) * c.r;
            const py = c.y + Math.sin(angle) * c.r;
            i === 0 ? ctx!.moveTo(px, py) : ctx!.lineTo(px, py);
          }
        }
        ctx!.closePath();
        ctx!.stroke();
      }
    }

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let frameId = 0;
    function loop() {
      step();
      draw();
      frameId = requestAnimationFrame(loop);
    }

    resize();
    draw();
    if (!reducedMotion) {
      frameId = requestAnimationFrame(loop);

      // Pointer tracking only runs alongside the animation loop — with
      // reduced motion, the background stays a single static frame and
      // skips hover feedback too, rather than reacting to the cursor.
      canvas.style.pointerEvents = "auto";
      canvas.addEventListener("mousemove", (e) => {
        const rect = banner!.getBoundingClientRect();
        mouseX = e.clientX - rect.left;
        mouseY = e.clientY - rect.top;
      });
      canvas.addEventListener("mouseleave", () => {
        mouseX = null;
        mouseY = null;
      });
    }

    let resizeTimeout = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        resize();
        draw();
      }, 150);
    };
    window.addEventListener("resize", onResize);

    const onVisibilityChange = () => {
      if (document.hidden) {
        cancelAnimationFrame(frameId);
      } else if (!reducedMotion) {
        frameId = requestAnimationFrame(loop);
      }
    };
    document.addEventListener("visibilitychange", onVisibilityChange);

    cleanupKinetic = () => {
      cancelAnimationFrame(frameId);
      window.clearTimeout(resizeTimeout);
      window.removeEventListener("resize", onResize);
      document.removeEventListener("visibilitychange", onVisibilityChange);
    };
  }

  document.addEventListener("astro:page-load", initHeroKineticBackground);
  document.addEventListener("astro:before-swap", () => {
    cleanupKinetic?.();
    cleanupKinetic = null;
  });
</script>
