---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { withBase } from "../lib/url";

import workPortrait1 from "../assets/homepage/work-portrait-1.webp";
import workPortrait2 from "../assets/homepage/work-portrait-2.webp";
import workArchitecture1 from "../assets/homepage/work-architecture-1.webp";
import workArchitecture2 from "../assets/homepage/work-architecture-2.webp";
import workProduct1 from "../assets/homepage/work-product-1.webp";
import workProduct2 from "../assets/homepage/work-product-2.webp";

// Temporary: sourced from the live abnersoto.com site as placeholder
// imagery for this homepage redesign, until Strange Light Media has its
// own shoot to pull from — swap these for real work whenever it exists.
const workSamples = [
  { src: workArchitecture1, alt: "Primary bedroom interior, warm evening light", category: "architecture" },
  { src: workPortrait1, alt: "Studio portrait, subject smiling with arms crossed", category: "portraits" },
  { src: workProduct1, alt: "Product still life", category: "product" },
  { src: workProduct2, alt: "Product still life", category: "product" },
  { src: workPortrait2, alt: "Studio portrait", category: "portraits" },
  { src: workArchitecture2, alt: "Architectural interior", category: "architecture" },
];

const audiences = [
  { name: "Real estate agents", body: "Listings that stop the scroll, and a personal brand that wins the next listing." },
  { name: "Builders & developers", body: "Launch films and campaigns that sell the project before it's finished." },
  { name: "Local businesses", body: "Content with real character, made in Sacramento." },
];

const services = [
  { num: "01", name: "Film & video", body: "Brand films, listing tours and short cuts for social." },
  { num: "02", name: "Photography", body: "Property, people and product, shot with real light." },
  { num: "03", name: "Social content", body: "Reels, carousels and monthly content that looks like you." },
  { num: "04", name: "Campaigns & brand", body: "Strategy, ads and launches built around the visuals." },
];

const steps = [
  { name: "Find the light", body: "A quick call to find the real story and the angle no one else is shooting." },
  { name: "Shoot it like a film", body: "On location or in studio, composed and lit with intention — not a flat listing shot." },
  { name: "Launch, then keep going", body: "Delivered fast, ready for the feed, the site, the sign." },
];

const traits = ["Cinematic", "Unexpected", "Sharp", "Rooted"];
---

<BaseLayout
  title="Strange Light Media"
  description="We make Sacramento brands impossible to scroll past."
>
  <section class="hero-banner">
    <div class="hero-banner__flare" aria-hidden="true">
      <div class="flare__streak"></div>
      <div class="flare__orb flare__orb--core"></div>
      <div class="flare__orb flare__orb--ghost1"></div>
      <div class="flare__orb flare__orb--ghost2"></div>
      <div class="flare__orb flare__orb--ghost3"></div>
    </div>
    <div class="hero container">
      <p class="hero__eyebrow">Sacramento · Marketing &amp; production</p>
      <h1>Strange<br />Light<span class="hero__sub">Media</span></h1>
      <p class="hero__tagline">
        Marketing that looks like nothing else in the valley.
      </p>
      <div class="hero__ctas">
        <a href={withBase("/work")} class="hero__cta">View the work &rarr;</a>
        <a href={withBase("/contact")} class="hero__cta hero__cta--secondary">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="container positioning">
    <h2 class="positioning__statement">
      We make Sacramento brands <span class="accent">impossible to scroll past.</span>
    </h2>
    <ul class="positioning__audiences">
      {
        audiences.map((a) => (
          <li>
            <h3>{a.name}</h3>
            <p>{a.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container services">
    <p class="section-eyebrow">What we do</p>
    <ul class="services__grid">
      {
        services.map((s) => (
          <li class="services__card">
            <p class="services__num">{s.num}</p>
            <h3>{s.name}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container work">
    <div class="work__header">
      <p class="section-eyebrow">Recent work</p>
      <a href={withBase("/work")} class="work__all">See all work &rarr;</a>
    </div>
    <ul class="work__grid">
      {
        workSamples.map((w) => (
          <li>
            <a href={withBase(`/work/${w.category}`)}>
              <Image src={w.src} alt={w.alt} width={700} />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container process">
    <p class="section-eyebrow">How it works</p>
    <ol class="process__steps">
      {
        steps.map((step, i) => (
          <li>
            <p class="process__num">{String(i + 1).padStart(2, "0")}</p>
            <h3>{step.name}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container traits">
    <ul class="traits__list">
      {traits.map((trait) => <li>{trait}</li>)}
    </ul>
  </section>

  <section class="container cta">
    <h2>Make it seen.</h2>
    <p>Tell us about the project and we'll follow up to talk dates and details.</p>
    <a href={withBase("/contact")} class="hero__cta">Get in touch &rarr;</a>
  </section>
</BaseLayout>

<style>
  .hero-banner {
    position: relative;
    overflow: hidden;
  }

  .hero-banner__flare {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  /* Faint anamorphic streak crossing the flare's travel path, the way a
     lens flare's horizontal line brightens as the light source nears
     frame center and fades as it moves off. */
  .flare__streak {
    position: absolute;
    top: 42%;
    left: -20%;
    width: 140%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 90, 54, 0.45) 45%,
      rgba(255, 221, 200, 0.85) 50%,
      rgba(255, 90, 54, 0.45) 55%,
      transparent
    );
    transform: translateY(-50%) rotate(-6deg) scaleX(0.4);
    filter: blur(1px);
    animation: flare-streak 16s ease-in-out infinite;
  }

  .flare__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    animation: flare-drift 20s ease-in-out infinite;
  }

  /* The bright source. */
  .flare__orb--core {
    top: 24%;
    left: 12%;
    width: clamp(120px, 14vw, 220px);
    height: clamp(120px, 14vw, 220px);
    background: radial-gradient(
      circle,
      rgba(255, 237, 225, 0.95) 0%,
      rgba(255, 120, 80, 0.55) 35%,
      rgba(255, 90, 54, 0.18) 60%,
      transparent 75%
    );
  }

  /* Secondary reflections ("ghosts"), smaller and dimmer along the same
     travel path — the chain of circles a real lens produces behind the
     light source. */
  .flare__orb--ghost1 {
    top: 46%;
    left: 34%;
    width: clamp(48px, 6vw, 90px);
    height: clamp(48px, 6vw, 90px);
    background: radial-gradient(circle, rgba(255, 110, 70, 0.5), transparent 70%);
    animation-delay: -2s;
    opacity: 0.7;
  }

  .flare__orb--ghost2 {
    top: 58%;
    left: 50%;
    width: clamp(24px, 3vw, 46px);
    height: clamp(24px, 3vw, 46px);
    background: radial-gradient(circle, rgba(255, 90, 54, 0.4), transparent 70%);
    animation-delay: -5s;
    opacity: 0.55;
  }

  .flare__orb--ghost3 {
    top: 20%;
    left: 62%;
    width: clamp(14px, 2vw, 26px);
    height: clamp(14px, 2vw, 26px);
    background: radial-gradient(circle, rgba(255, 221, 200, 0.5), transparent 70%);
    animation-delay: -8s;
    opacity: 0.4;
  }

  @keyframes flare-drift {
    0% {
      transform: translate(-8vw, 3vh) scale(0.85);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    50% {
      transform: translate(5vw, -2vh) scale(1.08);
      opacity: 0.95;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translate(16vw, -7vh) scale(0.85);
      opacity: 0;
    }
  }

  @keyframes flare-streak {
    0%,
    100% {
      opacity: 0;
      transform: translateY(-50%) rotate(-6deg) scaleX(0.4);
    }
    50% {
      opacity: 0.8;
      transform: translateY(-50%) rotate(-6deg) scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flare__orb,
    .flare__streak {
      animation: none;
      opacity: 0.5;
    }
  }

  .hero {
    position: relative;
    padding-block: var(--space-6);
    max-width: 700px;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .hero h1 {
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    letter-spacing: -0.02em;
    line-height: 0.95;
  }

  /* "Media", set apart from the stacked "Strange Light" wordmark above
     it — matches the brand deck's cover slide treatment (a
     wide-tracked mono subline in the accent color). */
  .hero__sub {
    display: block;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.35em;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 0.5em;
  }

  .hero__tagline {
    margin-top: var(--space-3);
    max-width: 30ch;
    color: var(--color-text-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .hero__cta {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    color: var(--color-accent);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .hero__cta--secondary {
    color: var(--color-text-muted);
  }

  .accent {
    color: var(--color-accent);
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  /* Positioning / audience */
  .positioning {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .positioning__statement {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    line-height: 1.15;
    max-width: 18ch;
    margin-bottom: var(--space-5);
  }

  .positioning__audiences {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 760px) {
    .positioning__audiences {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .positioning__audiences h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .positioning__audiences p {
    color: var(--color-text-muted);
  }

  /* Services */
  .services {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .services__grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .services__card {
    border-top: 2px solid var(--color-border);
    padding-top: var(--space-2);
  }

  .services__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .services__card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .services__card p:not(.services__num) {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  /* Work */
  .work {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .work__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .work__header .section-eyebrow {
    margin-bottom: 0;
  }

  .work__all {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  @media (min-width: 760px) {
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .work__grid :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 0.2s ease;
  }

  .work__grid a:hover :global(img) {
    opacity: 0.85;
  }

  /* Process */
  .process {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .process__steps {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 760px) {
    .process__steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .process__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .process__steps h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .process__steps p:not(.process__num) {
    color: var(--color-text-muted);
  }

  /* Traits band */
  .traits {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .traits__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .traits__list li {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .traits__list li::before {
    content: "";
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    border-radius: 50%;
    background: var(--color-accent);
    margin-right: 0.5em;
    vertical-align: middle;
  }

  /* Closing CTA */
  .cta {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .cta h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-2);
  }

  .cta p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .cta .hero__cta {
    display: inline-block;
  }
</style>
