---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import headshot from "../assets/about-headshot.jpg";
---

<BaseLayout
  title="About"
  description="Placeholder about-page description — replace with Strange Light Media's real bio copy."
>
  <section class="container about">
    <div class="about__headshot">
      <Image src={headshot} alt="Placeholder headshot" width={640} />
    </div>
    <div class="about__copy">
      <h1>About</h1>
      <p>
        Placeholder bio copy. Replace this paragraph (and the ones below)
        with Strange Light Media's real about-page content once the design
        files are ready.
      </p>
      <p>
        A second placeholder paragraph, so the layout can be previewed with
        a realistic amount of body copy rather than a single short line.
      </p>
      <p>
        A third, shorter placeholder line — swap all of this out along with
        the headshot above.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: 320px 1fr;
      align-items: start;
    }
  }

  .about__headshot {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 4px;
  }

  .about__headshot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about h1 {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .about__copy p + p {
    margin-top: var(--space-2);
  }
</style>
